# Secrets — .env holds a live Anthropic key
.env
.env.local
*.pem

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
build/
dist/

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local data
*.db
*.sqlite3

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Kubernetes / load testing
# kind writes its kubeconfig to ~/.kube/config, outside the repo; these cover
# anything exported here by hand, and raw k6 output (the summarised, dated
# numbers live in docs/load-test-results.md).
kubeconfig*
*.kubeconfig
loadtest/results/
loadtest/*.json
!loadtest/*.example.json

# Downloaded CI logs (evals/root_cause/extract_github_history.py)
.cache/

# Eval runs: diagnostic runs are regenerated by CI; traces are bulky. Commit
# _state.json (holds the harness approval) and recorded Claude runs' results.
.claude/hillclimb/**/diag-*/
.claude/hillclimb/**/traces/
.claude/hillclimb/**/report.html
.claude/hillclimb/**/trajectory/
