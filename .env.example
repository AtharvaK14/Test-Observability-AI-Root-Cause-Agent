# Copy to .env and fill in. Never commit .env.
# Every value here has a working default except ANTHROPIC_API_KEY.

# --- Service -----------------------------------------------------------------
ENVIRONMENT=local                 # local | ci | staging | prod
LOG_LEVEL=INFO
LOG_JSON=false                    # true in production (machine-parseable)

# --- Database ----------------------------------------------------------------
# DEFAULT: SQLite. No server, no install — the database is a file created on
# first run. Right for local development and for trying the project out.
DATABASE_URL=sqlite+pysqlite:///./demo.db

# PRODUCTION / docker-compose: PostgreSQL. Uncomment this and comment out the
# line above. `docker compose up` sets it for you, so you only need this when
# pointing at a Postgres you run yourself.
#
# Note the `+psycopg` driver suffix (psycopg 3, which is what is installed).
# A bare `postgres://` URL is normalised automatically, but `postgresql://`
# with no driver resolves to psycopg2 — which is NOT installed, and fails with
# a confusing ModuleNotFoundError rather than a connection error.
#
# DATABASE_URL=postgresql+psycopg://tobs:tobs@localhost:5432/test_observability

DB_POOL_SIZE=5                    # ignored by SQLite
DB_MAX_OVERFLOW=10                # ignored by SQLite
DB_ECHO=false                     # true logs every SQL statement

# --- Claude ------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5      # claude-sonnet-5 to trade depth for cost at volume
ANTHROPIC_EFFORT=high              # low | medium | high | xhigh | max
ANTHROPIC_MAX_TOKENS=16000         # caps thinking AND output together
ANTHROPIC_TIMEOUT_SECONDS=300
ANTHROPIC_MAX_RETRIES=3
ANTHROPIC_ENABLE_REFUSAL_FALLBACK=true

# --- Agent behaviour ---------------------------------------------------------
AGENT_ENABLED=true                 # false = ingestion only, no analysis at all

# Which classifier runs. 'heuristic' needs no API key, no network, and costs
# nothing — it is also the baseline the LLM's accuracy is measured against.
# 'claude' uses the agent. Verdicts are tagged with different prompt_version
# values so the two accuracies stay separable.
ANALYSIS_MODE=heuristic            # heuristic | claude
AGENT_MAX_ITERATIONS=4             # tool-use turns before a verdict is forced
AUTO_ANALYZE_ON_INGEST=true        # false to analyse on demand only
ANALYSIS_CONFIDENCE_REVIEW_THRESHOLD=0.6

# --- Context retrieval -------------------------------------------------------
HISTORY_WINDOW_RUNS=30
CONTEXT_MAX_STACK_CHARS=4000
CONTEXT_MAX_LOG_CHARS=6000

# Optional: path to a checkout of the system under test. When set, failures are
# enriched with real commit metadata. When unset, git context is reported as
# unavailable — the system never fabricates a changed-file list, because
# invented evidence is worse than absent evidence once a model reasons over it.
# GIT_REPO_PATH=/repos/my-app

# --- API ---------------------------------------------------------------------
MAX_INGEST_BYTES=52428800          # 50 MB
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]
